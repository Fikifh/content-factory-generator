# ─────────────────────────────────────────────────────────
# .env.example — Template for content-factory-generator
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (see .gitignore).
# ─────────────────────────────────────────────────────────

# ── Gemini API (Google AI Studio)
# Get yours: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pexels API (stock footage)
# Get yours: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── Text-to-Speech settings (Edge TTS)
# Default voice: Indonesian natural female
TIKTOK_VOICE=id-ID-ArdiNeural
# Speed: e.g. +10%, +20%, -10%
TIKTOK_SPEED=+10%
